# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://...

# JWT signing secret (required — server won't start without it)
JWT_SECRET=generate-a-random-64-char-string

# Resend API key for email delivery
RESEND_API_KEY=re_...

# F04: Application-level vault encryption (AES-256-GCM key, 64-char hex)
VAULT_ENCRYPTION_KEY=generate-a-random-64-char-hex-string

# F101: VAPID keypair for Web Push (generated once, set permanently)
# If not set, a new pair will be generated at startup and logged —
# copy the logged values to these env vars and restart.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# F115: Trusted person auto-release window (hours). The trusted person is
# notified first on an overdue check-in; if they don't respond within this
# window, the other contacts are notified automatically. Defaults to 48.
TRUSTED_RESPONSE_HOURS=48
